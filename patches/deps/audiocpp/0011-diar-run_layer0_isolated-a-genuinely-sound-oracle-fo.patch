 .../engine/models/nemotron_3_diar/encoder.h   | 34 +++++++
 src/models/nemotron_3_diar/encoder.cpp        | 94 +++++++++++++++++++
 src/models/nemotron_3_diar/session.cpp        | 32 +++++++
 3 files changed, 160 insertions(+)

diff --git a/include/engine/models/nemotron_3_diar/encoder.h b/include/engine/models/nemotron_3_diar/encoder.h
index 3c0eed9..586045b 100644
--- a/include/engine/models/nemotron_3_diar/encoder.h
+++ b/include/engine/models/nemotron_3_diar/encoder.h
@@ -54,6 +54,40 @@ struct TracedStage {
 const std::vector<TracedStage> & traced_layer_stages();
 void clear_traced_layer_stages();
 
+// docs/one-runtime-merge.md SS12: the running 32-layer graph cannot be a sound oracle for its own
+// intermediates - ggml_set_output on a per-layer stage does not stop a LATER, structurally identical layer's
+// tensor from landing on the same gallocr slot (confirmed: 02_qkv, 05_v, 07_oproj and 11_ffn_out all read
+// back corrupted despite the flag). This builds ONLY encoder layer 0 as its own graph with nothing else that
+// could ever alias across LAYERS, which is enough to make the final output and most stages (01/03/04/06/08/10
+// - verified byte-identical to the production trace) sound. It is NOT a complete fix: 07_oproj and 11_ffn_out
+// still alias EACH OTHER within this single-layer graph (same bytes, ggml_set_output notwithstanding), and
+// 02_qkv/05_v/09_ffn_in read back plausible but as yet uncross-checked values - see SS12 for the open
+// question and use the true final output (`output` below) as the primary acceptance test. No production code
+// path calls this - it exists for the port comparison only.
+struct Layer0IsolatedResult {
+    std::vector<float> output;          // [hidden, frames] - the layer's true final output
+    std::vector<TracedStage> stages;    // named intermediates; valid until this result is destroyed
+    ggml_context * ggml = nullptr;      // owns the tensor structs above
+    ggml_gallocr_t allocator = nullptr; // owns the tensors' DATA - freeing it before `stages` is read back is
+                                        // a real bug this function's first draft had: read_tensor_f32_into
+                                        // silently returns zeros off a freed buffer, no error. Keep it alive
+                                        // until the caller is done, then let this destructor free it.
+    ~Layer0IsolatedResult();
+    Layer0IsolatedResult() = default;
+    Layer0IsolatedResult(Layer0IsolatedResult &&) noexcept;
+    Layer0IsolatedResult & operator=(Layer0IsolatedResult &&) noexcept;
+    Layer0IsolatedResult(const Layer0IsolatedResult &) = delete;
+    Layer0IsolatedResult & operator=(const Layer0IsolatedResult &) = delete;
+};
+
+Layer0IsolatedResult run_layer0_isolated(
+    ggml_backend_t backend,
+    const EncoderLayerWeights & weights,
+    const EncoderConfig & config,
+    const std::vector<float> & input,   // [hidden, frames], hidden fastest - same layout as layer0_in.f32
+    int64_t frames,
+    int64_t valid_frames);              // <= frames; matches attention_mask()'s [valid_frames, frames) pad
+
 void ensure_pre_encode_graph(
     std::unique_ptr<PreEncodeGraph> & graph,
     const core::ExecutionContext & execution,
diff --git a/src/models/nemotron_3_diar/encoder.cpp b/src/models/nemotron_3_diar/encoder.cpp
index 2faf444..5c11bb1 100644
--- a/src/models/nemotron_3_diar/encoder.cpp
+++ b/src/models/nemotron_3_diar/encoder.cpp
@@ -1,4 +1,5 @@
 #include "engine/models/nemotron_3_diar/encoder.h"
+#include "ggml-cpu.h"
 
 #include <cstdlib>
 #include <cstring>
@@ -172,6 +173,99 @@ void allocate_graph(
 PreEncodeGraph::~PreEncodeGraph() { release_graph(backend, ggml, graph, plan, allocator); }
 EncoderGraph::~EncoderGraph() { release_graph(backend, ggml, graph, plan, allocator); }
 
+Layer0IsolatedResult::~Layer0IsolatedResult() {
+    if (allocator != nullptr) ggml_gallocr_free(allocator);
+    if (ggml != nullptr) ggml_free(ggml);
+}
+Layer0IsolatedResult::Layer0IsolatedResult(Layer0IsolatedResult && other) noexcept
+    : output(std::move(other.output)), stages(std::move(other.stages)), ggml(other.ggml),
+      allocator(other.allocator) {
+    other.ggml = nullptr;
+    other.allocator = nullptr;
+}
+Layer0IsolatedResult & Layer0IsolatedResult::operator=(Layer0IsolatedResult && other) noexcept {
+    if (this != &other) {
+        if (allocator != nullptr) ggml_gallocr_free(allocator);
+        if (ggml != nullptr) ggml_free(ggml);
+        output = std::move(other.output);
+        stages = std::move(other.stages);
+        ggml = other.ggml;
+        allocator = other.allocator;
+        other.ggml = nullptr;
+        other.allocator = nullptr;
+    }
+    return *this;
+}
+
+Layer0IsolatedResult run_layer0_isolated(
+    ggml_backend_t backend,
+    const EncoderLayerWeights & weights,
+    const EncoderConfig & config,
+    const std::vector<float> & input,
+    int64_t frames,
+    int64_t valid_frames) {
+    Layer0IsolatedResult result;
+    const int64_t hidden = config.hidden_size;
+    if (static_cast<int64_t>(input.size()) != hidden * frames) {
+        throw std::runtime_error("run_layer0_isolated: input size does not match hidden*frames");
+    }
+    const size_t arena_bytes = ggml_tensor_overhead() * 512 + ggml_graph_overhead_custom(1024, false);
+    result.ggml = ggml_init({arena_bytes, nullptr, true});
+    if (result.ggml == nullptr) throw std::runtime_error("run_layer0_isolated: ggml_init failed");
+    core::ModuleBuildContext ctx{result.ggml, "nemotron_3_diar.layer0_isolated", core::BackendType::Cpu};
+
+    auto in_tv = core::make_tensor(ctx, GGML_TYPE_F32, core::TensorShape::from_dims({1, frames, hidden}));
+    auto mask_tv = core::make_tensor(ctx, GGML_TYPE_F16, core::TensorShape::from_dims({1, 1, frames, frames}));
+    const int64_t head_dim = hidden / config.heads;
+    auto cos_tv = core::make_tensor(
+        ctx, GGML_TYPE_F32, core::TensorShape::from_dims({1, config.heads, frames, head_dim / 2}));
+    auto sin_tv = core::make_tensor(
+        ctx, GGML_TYPE_F32, core::TensorShape::from_dims({1, config.heads, frames, head_dim / 2}));
+
+    // A fresh context with only this one layer in it: nothing else can ever be allocated on top of these
+    // tensors' memory, so marking them ggml_set_output below is - unlike in the full 32-layer graph - actually
+    // sufficient to make them sound.
+    reset_traced_layer();
+    auto out_tv = build_encoder_layer(ctx, in_tv, mask_tv, cos_tv, sin_tv, weights, config);
+
+    ggml_set_input(in_tv.tensor);
+    ggml_set_input(mask_tv.tensor);
+    ggml_set_input(cos_tv.tensor);
+    ggml_set_input(sin_tv.tensor);
+    ggml_set_output(out_tv.tensor);
+    for (const auto & stage : traced_layer_stages()) ggml_set_output(stage.tensor);
+
+    ggml_cgraph * graph = ggml_new_graph_custom(result.ggml, 1024, false);
+    ggml_build_forward_expand(graph, out_tv.tensor);
+    ggml_gallocr_t allocator = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
+    if (!ggml_gallocr_alloc_graph(allocator, graph)) {
+        ggml_gallocr_free(allocator);
+        throw std::runtime_error("run_layer0_isolated: failed to allocate graph");
+    }
+
+    core::write_tensor_f32(in_tv, input);
+    core::write_tensor_f16(mask_tv, attention_mask({valid_frames}, frames));
+    core::write_tensor_f32(cos_tv, rope_table(1, config.heads, frames, head_dim, config.rope_theta, true));
+    core::write_tensor_f32(sin_tv, rope_table(1, config.heads, frames, head_dim, config.rope_theta, false));
+
+    const auto status = ggml_backend_graph_compute(backend, graph);
+    if (status != GGML_STATUS_SUCCESS) {
+        ggml_gallocr_free(allocator);
+        throw std::runtime_error("run_layer0_isolated: graph compute failed");
+    }
+
+    result.output.resize(static_cast<size_t>(ggml_nelements(out_tv.tensor)));
+    core::read_tensor_f32_into(out_tv.tensor, result.output);
+    result.stages = traced_layer_stages();
+    // Do NOT free the allocator here: it owns the DATA behind every tensor in `result.stages`, which the
+    // caller reads AFTER this function returns. An earlier draft freed it at this point and every stage read
+    // back as silent zeros - freeing releases the underlying buffer immediately (unlike ggml_gallocr_free
+    // called before a graph is even computed, which is safe - tools/layer0_port.cpp's own working pattern).
+    // Ownership transfers to `result`; ~Layer0IsolatedResult frees it once the caller is done.
+    result.allocator = allocator;
+    return result;
+}
+
 void ensure_pre_encode_graph(
     std::unique_ptr<PreEncodeGraph> & graph,
     const core::ExecutionContext & execution,
diff --git a/src/models/nemotron_3_diar/session.cpp b/src/models/nemotron_3_diar/session.cpp
index fe385db..2c57d31 100644
--- a/src/models/nemotron_3_diar/session.cpp
+++ b/src/models/nemotron_3_diar/session.cpp
@@ -310,6 +310,38 @@ std::vector<float> Session::encode(
         std::fprintf(stderr, "[diar-dump] layer0 in %zu floats, out %zu floats (hidden=%lld frames=%lld) -> %s\n",
                      tin.size(), tout.size(), (long long) encoder_graph_->layer0_in.tensor->ne[0],
                      (long long) encoder_graph_->layer0_in.tensor->ne[1], dir);
+        // docs/one-runtime-merge.md SS12: the stages just dumped above are read out of the running 32-layer
+        // graph and are not all sound (02_qkv/05_v/07_oproj/11_ffn_out read back corrupted despite
+        // ggml_set_output - a later layer's structurally identical tensor lands on the same gallocr slot).
+        // run_layer0_isolated rebuilds layer 0 alone, with the SAME real weights and the SAME captured
+        // input/valid_frames, in a graph with nothing else in it, so every stage it returns is a true graph
+        // output. Opt-in and independent of AUDIOCPP_DUMP_LAYER0's own correctness - this only needs `tin`,
+        // `frames`, and `valid_frames`, all already computed above for the existing dump.
+        if (const char * iso_dir = std::getenv("AUDIOCPP_LAYER0_ISOLATED"); iso_dir != nullptr) {
+            auto iso = run_layer0_isolated(
+                execution_context().backend(), weights_->layers[0], assets_->model_config.encoder,
+                tin, frames, valid_frames.empty() ? frames : valid_frames[0]);
+            const std::string ibase = std::string(iso_dir) + "/iso";
+            auto dump_vec = [&](const char * suffix, const ggml_tensor * shape_src, const std::vector<float> & v) {
+                std::FILE * fh = std::fopen((ibase + suffix).c_str(), "wb");
+                if (fh == nullptr) return;
+                std::fwrite(v.data(), sizeof(float), v.size(), fh);
+                std::fclose(fh);
+                if (shape_src == nullptr) return;
+                std::FILE * nh = std::fopen((ibase + suffix + ".ne").c_str(), "wb");
+                if (nh == nullptr) return;
+                for (int64_t d = 0; d < GGML_MAX_DIMS; ++d)
+                    std::fprintf(nh, "%lld%c", (long long) shape_src->ne[d], d + 1 == GGML_MAX_DIMS ? '\n' : ' ');
+                std::fclose(nh);
+            };
+            dump_vec("_out.f32", nullptr, iso.output);
+            for (const auto & stage : iso.stages) {
+                std::vector<float> v(static_cast<size_t>(ggml_nelements(stage.tensor)));
+                core::read_tensor_f32_into(stage.tensor, v);
+                dump_vec(("_" + stage.name + ".f32").c_str(), stage.tensor, v);
+            }
+            std::fprintf(stderr, "[diar-dump] %zu isolated stage(s) written -> %s\n", iso.stages.size(), iso_dir);
+        }
     }
     if (prof) {
         const double dt = std::chrono::duration<double>(
