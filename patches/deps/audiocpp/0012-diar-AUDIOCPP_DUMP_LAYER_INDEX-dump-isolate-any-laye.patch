From 0babdf9a8b1404027c32534b2294d7c3d22b2624 Mon Sep 17 00:00:00 2001
From: autoresearch <agent@localhost>
Date: Sat, 26 Sep 2026 04:27:48 +0000
Subject: [PATCH] diar: AUDIOCPP_DUMP_LAYER_INDEX - dump/isolate any layer, not
 just layer 0

The dump/trace/isolated-harness machinery all hardcoded index==0. build_encoder_layer takes no layer number,
only weights, so there is no structural reason the byte-exact port result (previous two commits) is specific
to layer 0 - but it was only ever checked against layer 0's real weights and activations. Generalized the
trigger to a configurable target layer (AUDIOCPP_DUMP_LAYER_INDEX, default 0 - identical behaviour when
unset) so the port could be checked against a genuinely different layer's data without restructuring
anything else. Production path unaffected: verified byte-identical turns output with the new code present
and the env var unset.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01QJVEwbN82WXJr6Us6kowEX
---
 src/models/nemotron_3_diar/encoder.cpp | 12 ++++++++++--
 src/models/nemotron_3_diar/session.cpp |  8 +++++++-
 2 files changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/models/nemotron_3_diar/encoder.cpp b/src/models/nemotron_3_diar/encoder.cpp
index 5c11bb1..7d850a8 100644
--- a/src/models/nemotron_3_diar/encoder.cpp
+++ b/src/models/nemotron_3_diar/encoder.cpp
@@ -338,8 +338,16 @@ void ensure_encoder_graph(
         config.encoder.hidden_size, config.encoder.layer_norm_eps, true, true,
     }).build(ctx, next->input, weights.embed_norm);
     const char * dump_dir = std::getenv("AUDIOCPP_DUMP_LAYER0");
+    // Which layer to dump/trace: defaults to 0 (the original, hardcoded behaviour). The op sequence is
+    // layer-index-independent (build_encoder_layer takes no layer number, only weights), so once layer 0
+    // ports byte-exact the remaining risk is empirical, not structural - this lets that be checked against a
+    // DIFFERENT layer's real weights without looping the whole 32-layer stack in the port.
+    const size_t target_layer = [] {
+        const char * s = std::getenv("AUDIOCPP_DUMP_LAYER_INDEX");
+        return s != nullptr ? static_cast<size_t>(std::max(0, atoi(s))) : size_t{0};
+    }();
     for (size_t index = 0; index < weights.layers.size(); ++index) {
-        if (dump_dir != nullptr && index == 0) {
+        if (dump_dir != nullptr && index == target_layer) {
             next->dump_layer0 = true;
             next->layer0_in = output;
             reset_traced_layer();
@@ -347,7 +355,7 @@ void ensure_encoder_graph(
         output = build_encoder_layer(
             ctx, output, next->attention_mask, next->rope_cos, next->rope_sin,
             weights.layers[index], config.encoder);
-        if (dump_dir != nullptr && index == 0) {
+        if (dump_dir != nullptr && index == target_layer) {
             // Recorded here, EXPANDED below: next->graph does not exist until after this loop, so calling
             // ggml_build_forward_expand from in here is a null dereference. (It was, and it segfaulted.)
             next->layer0_out = output;
diff --git a/src/models/nemotron_3_diar/session.cpp b/src/models/nemotron_3_diar/session.cpp
index 2c57d31..1fe5bb4 100644
--- a/src/models/nemotron_3_diar/session.cpp
+++ b/src/models/nemotron_3_diar/session.cpp
@@ -318,8 +318,14 @@ std::vector<float> Session::encode(
         // output. Opt-in and independent of AUDIOCPP_DUMP_LAYER0's own correctness - this only needs `tin`,
         // `frames`, and `valid_frames`, all already computed above for the existing dump.
         if (const char * iso_dir = std::getenv("AUDIOCPP_LAYER0_ISOLATED"); iso_dir != nullptr) {
+            // Same AUDIOCPP_DUMP_LAYER_INDEX as the dump above selects which layer's weights `tin`/`tout`
+            // actually belong to - default 0, matching the original hardcoded behaviour.
+            const size_t target_layer = [] {
+                const char * s = std::getenv("AUDIOCPP_DUMP_LAYER_INDEX");
+                return s != nullptr ? static_cast<size_t>(std::max(0, atoi(s))) : size_t{0};
+            }();
             auto iso = run_layer0_isolated(
-                execution_context().backend(), weights_->layers[0], assets_->model_config.encoder,
+                execution_context().backend(), weights_->layers[target_layer], assets_->model_config.encoder,
                 tin, frames, valid_frames.empty() ? frames : valid_frames[0]);
             const std::string ibase = std::string(iso_dir) + "/iso";
             auto dump_vec = [&](const char * suffix, const ggml_tensor * shape_src, const std::vector<float> & v) {
-- 
