 .../engine/models/nemotron_3_diar/session.h   | 15 ++++++
 src/capi/audiocpp.cpp                         | 51 +++++++++++++++++++
 src/models/nemotron_3_diar/session.cpp        |  1 +
 4 files changed, 95 insertions(+)

diff --git a/include/audiocpp.h b/include/audiocpp.h
index 76cfe6b..c14e046 100644
--- a/include/audiocpp.h
+++ b/include/audiocpp.h
@@ -255,6 +255,34 @@ AUDIOCPP_API void            audiocpp_session_free(audiocpp_session * session);
 
 AUDIOCPP_API const char * audiocpp_session_family(const audiocpp_session * session);
 
+/* Nemotron 3 Diarization only (fails AUDIOCPP_ERR_INVALID_ARGUMENT on any other family's session).
+ *
+ * docs/one-runtime-merge.md: redirects JUST the encoder+head compute to a caller-supplied ggml runtime -
+ * e.g. one that shares a scheduler with another model already running in the same process - while every
+ * other piece of the family (the mel frontend, streaming window scheduling, the arrival-order speaker-cache
+ * state, turn decoding) keeps running this library's own code, unmodified.
+ *
+ * `fn` receives the SAME packed-embeddings-in/probabilities-out contract the family's own internal encode()
+ * uses: `embeddings` is `batch * frames * hidden` packed [speaker_cache | fifo | chunk] frames, row-major;
+ * `valid_frames` has `batch` entries, one valid length per row (<= frames; anything past it is masked
+ * padding, not meaningful audio). `fn` must set `*out_probabilities` to a buffer of exactly
+ * `batch * frames * num_speakers` floats ALLOCATED WITH malloc() (audio.cpp frees it after copying - the one
+ * ownership rule for this hook) and `*out_len` to that count, then return 0. A nonzero return (or a null
+ * `*out_probabilities`) fails the encode() call with AUDIOCPP_ERR_RUNTIME.
+ *
+ * Pass fn == NULL to remove a previously-set hook and restore the library's own compute.
+ */
+typedef int (*audiocpp_nemotron3_diar_encode_fn)(
+    void * user_data,
+    const float * embeddings, int64_t batch, int64_t frames, int64_t hidden,
+    const int64_t * valid_frames,
+    float ** out_probabilities, int64_t * out_len);
+
+AUDIOCPP_API audiocpp_status audiocpp_nemotron3_diar_set_external_encoder(
+    audiocpp_session * session,
+    audiocpp_nemotron3_diar_encode_fn fn,
+    void * user_data);
+
 /* Optional. audiocpp_session_run() and audiocpp_stream_start() always prepare
  * with the request they are about to run -- preparation carries the input
  * length, so a session prepared for one request must not run another. Call this
diff --git a/include/engine/models/nemotron_3_diar/session.h b/include/engine/models/nemotron_3_diar/session.h
index 7713310..fea9e13 100644
--- a/include/engine/models/nemotron_3_diar/session.h
+++ b/include/engine/models/nemotron_3_diar/session.h
@@ -6,6 +6,7 @@
 #include "engine/framework/model_spec/metadata.h"
 #include "engine/framework/runtime/session_base.h"
 
+#include <functional>
 #include <memory>
 #include <set>
 #include <tuple>
@@ -28,6 +29,19 @@ public:
         std::shared_ptr<const model_spec::ModelContract> contract);
     ~Session() override;
 
+    // docs/one-runtime-merge.md (nemo-x-asr-diarizer.cpp, the composite this family was built for): lets a
+    // caller redirect JUST the encoder+head compute - encode()'s own signature, packed
+    // [speaker_cache | fifo | chunk] embeddings in, per-frame speaker probabilities out - to a DIFFERENT ggml
+    // runtime that shares one scheduler with another model in the same process, while every other piece of
+    // this class (the mel frontend, streaming window scheduling, the arrival-order speaker-cache state, turn
+    // decoding) keeps running exactly this code, unmodified. Unset (the default) leaves encode() byte-for-
+    // byte the same as before this hook existed - checked by encode()'s own first line, nothing upstream of
+    // it changes at all.
+    using ExternalEncoder = std::function<std::vector<float>(
+        const std::vector<float> & embeddings, int64_t batch, int64_t frames,
+        const std::vector<int64_t> & valid_frames)>;
+    void set_external_encoder(ExternalEncoder fn) { external_encoder_ = std::move(fn); }
+
     std::string family() const override;
     runtime::VoiceTaskKind task_kind() const override;
     runtime::RunMode run_mode() const override;
@@ -97,6 +111,7 @@ private:
     bool stream_started_ = false;
     size_t graph_arena_bytes_ = 1024ull * 1024ull * 1024ull;
     size_t weight_context_bytes_ = 1024ull * 1024ull * 1024ull;
+    ExternalEncoder external_encoder_;
 };
 
 }  // namespace engine::models::nemotron_3_diar
diff --git a/src/capi/audiocpp.cpp b/src/capi/audiocpp.cpp
index 1582084..d1039d3 100644
--- a/src/capi/audiocpp.cpp
+++ b/src/capi/audiocpp.cpp
@@ -20,9 +20,15 @@
 #include "engine/framework/runtime/model.h"
 #include "engine/framework/runtime/registry.h"
 #include "engine/framework/runtime/session.h"
+// One narrow, deliberate exception to "never a family-specific include" (see the file banner): the external-
+// encoder hook (docs/one-runtime-merge.md) is nemotron_3_diar-specific by nature - it redirects THAT
+// family's encoder+head compute to a caller-supplied ggml runtime while leaving everything else about the
+// family (mel frontend, streaming state, turn decoding) untouched. No other function in this file touches it.
+#include "engine/models/nemotron_3_diar/session.h"
 
 #include <cstddef>
 #include <cstdint>
+#include <cstdlib>
 #include <exception>
 #include <filesystem>
 #include <iterator>
@@ -529,6 +535,51 @@ void audiocpp_session_free(audiocpp_session * session) {
     delete session;
 }
 
+audiocpp_status audiocpp_nemotron3_diar_set_external_encoder(
+    audiocpp_session * session,
+    audiocpp_nemotron3_diar_encode_fn fn,
+    void * user_data) {
+    if (session == nullptr) return fail(AUDIOCPP_ERR_INVALID_ARGUMENT, "session must be non-null");
+    if (session->family != "nemotron_3_diar") {
+        return fail(AUDIOCPP_ERR_INVALID_ARGUMENT,
+                    "audiocpp_nemotron3_diar_set_external_encoder requires a nemotron_3_diar session");
+    }
+    return guard([&] {
+        auto * diar = dynamic_cast<engine::models::nemotron_3_diar::Session *>(session->session.get());
+        if (diar == nullptr) {
+            throw std::runtime_error("nemotron_3_diar session did not downcast to its own Session type");
+        }
+        if (fn == nullptr) {
+            diar->set_external_encoder(nullptr);
+            return AUDIOCPP_OK;
+        }
+        // The callback allocates its return buffer with malloc(); this lambda copies it into the
+        // std::vector<float> encode() actually returns and frees the malloc'd buffer - the ONE ownership
+        // rule for this hook, documented on the typedef in audiocpp.h.
+        diar->set_external_encoder(
+            [fn, user_data](
+                const std::vector<float> & embeddings, int64_t batch, int64_t frames,
+                const std::vector<int64_t> & valid_frames) -> std::vector<float> {
+                float * out = nullptr;
+                int64_t out_len = 0;
+                const int64_t hidden =
+                    frames > 0 && batch > 0
+                        ? static_cast<int64_t>(embeddings.size()) / (batch * frames)
+                        : 0;
+                const int rc = fn(
+                    user_data, embeddings.data(), batch, frames, hidden,
+                    valid_frames.data(), &out, &out_len);
+                if (rc != 0 || out == nullptr) {
+                    throw std::runtime_error("nemotron_3_diar external encoder callback failed");
+                }
+                std::vector<float> result(out, out + out_len);
+                std::free(out);
+                return result;
+            });
+        return AUDIOCPP_OK;
+    });
+}
+
 const char * audiocpp_session_family(const audiocpp_session * session) {
     if (session == nullptr) return kEmptyString;
     return session->family.c_str();
