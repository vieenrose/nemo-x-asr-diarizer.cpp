+            if (fh != nullptr) { std::fwrite(eout.data(), sizeof(float), eout.size(), fh); std::fclose(fh); }
+            std::fprintf(stderr, "[diar-dump] isolated FULL encoder (%zu layers) written -> %s\n",
+                         weights_->layers.size(), enc_dir);
+        }
     }
