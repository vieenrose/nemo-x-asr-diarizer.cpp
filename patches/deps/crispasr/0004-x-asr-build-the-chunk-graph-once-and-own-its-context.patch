+    // worked because the next allocation happened to land on the freed block. Owning the context here makes
+    // both the reuse and the lifetime correct.
+    ggml_cgraph* chunk_gf = nullptr;
+    ggml_context* chunk_ctx = nullptr;
+    std::vector<std::vector<float>> pes_cache;
